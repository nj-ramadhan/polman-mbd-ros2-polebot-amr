<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">
  <xacro:macro name="camera_sensor" params="
    name 
    parent_link 
    joint_xyz joint_rpy 
    mesh_xyz:='0 0 0' mesh_rpy:='0 0 0'">

    <!-- Main camera link -->
    <link name="${name}_link">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
      </inertial>

      <visual>
        <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://polebot_amr_description/meshes/camera.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="0.8 0.8 0.8 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.02 0.03 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Fixed joint to robot -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${joint_xyz}" rpy="${joint_rpy}"/>
    </joint>

    <!-- Optical frame (Z forward, X right, Y down) -->
    <link name="${name}_link_optical"/>

    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_link_optical"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/> <!-- 90° around X and Z -->
    </joint>

    <!-- Gazebo camera sensor (OUTSIDE link) -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <topic>/camera/image</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.1</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
        <plugin filename="libros_gz_sensor_plugin.so" name="ros_gz::SensorPlugin">
          <ros>
            <frame_id>${name}_link_optical</frame_id>
            <remapping>/camera/image:=/camera/image_raw</remapping>
            <remapping>/camera/camera_info:=/camera/camera_info</remapping>
          </ros>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>