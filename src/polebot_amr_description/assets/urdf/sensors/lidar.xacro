<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lidar">
  <xacro:property name="mesh_path" value="$(find polebot_amr_description)/meshes"/>
  <xacro:macro name="lidar_sensor" params="
    name 
    parent_link 
    joint_xyz joint_rpy 
    mesh_xyz mesh_rpy
    update_rate:=10
    ray_count:=270
    min_angle:='-2.3592'
    max_angle:='2.3592'
    min_range:='0.05'
    max_range:='25.0'
    range_resolution:='0.013'
    topic_name:='scan'
    always_on:=true
    visualize:=true">

    <!-- Link -->
    <link name="${name}_link">
      <inertial> ... </inertial>
      <visual> ... </visual>
      <collision> ... </collision>
      <!-- NO <gazebo> inside here -->
    </link>

    <!-- Joint -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${joint_xyz}" rpy="${joint_rpy}"/>
    </joint>

    <!-- Gazebo sensor (outside link!) -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <topic>${name}/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>270</samples>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>25.0</max>
          </range>
        </lidar>
        <plugin filename="libros_gz_sensor_plugin.so" name="ros_gz::SensorPlugin">
          <ros>
            <frame_id>${name}_link</frame_id>
            <remapping>${name}/scan:=/scan</remapping>
          </ros>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
